PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bricomenage

FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

JWT_SECRET=bricomenage_mysql_secret_2026_change_me
JWT_EXPIRES_IN=8h

ADMIN_EMAIL=admin@bricomenage.dz
ADMIN_PASSWORD=Admin@123


# ================================
# SOCKET.IO / WHATSAPP ADMIN
# ================================
# Socket.IO utilise le même port que l'API (PORT).

# Notification WhatsApp Business Cloud API.
WHATSAPP_ENABLED=false
# Numéro admin au format international sans +, ex. 213555123456
WHATSAPP_ADMIN_NUMBER=213XXXXXXXXX
# Depuis Meta Developers > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Ex. v23.0 / version Graph activée dans votre application Meta
WHATSAPP_GRAPH_VERSION=

# Recommandé pour un message automatique initié par l'entreprise :
# nom d'un template WhatsApp approuvé comportant 6 variables body :
# suivi, client, téléphone, destination, total, produits.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=fr

# Laisser vide pour utiliser automatiquement l'heure du PC
DB_TIMEZONE=


# ================================
# ZR EXPRESS - NOUVELLE PLATEFORME
# ================================
ZR_EXPRESS_ENABLED=false
ZR_EXPRESS_TENANT_ID=
ZR_EXPRESS_SECRET_KEY=
# Si vide, le backend cherche automatiquement un hub contenant "Oran".
ZR_EXPRESS_SOURCE_HUB_ID=
ZR_EXPRESS_SOURCE_HUB_SEARCH=Oran
ZR_EXPRESS_DEFAULT_WEIGHT_KG=1
# false = l'admin clique sur "Créer le colis ZR" après validation de la commande.
ZR_EXPRESS_AUTO_CREATE=false
